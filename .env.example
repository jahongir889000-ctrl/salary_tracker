# ==========================================
# Переменные окружения для Turso и Vercel
# ==========================================

# База данных Turso (LibSQL)
# Получите URL и токен в панели Turso (https://turso.tech) или через CLI:
# turso db show <db-name> --url
# turso db tokens create <db-name>
TURSO_DATABASE_URL=libsql://your-db-name-your-username.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Секретный ключ для JWT-токенов
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Разрешенный URL клиента для CORS (при раздельном деплое или локальной разработке)
# Для Vercel при едином деплое эта переменная не обязательна
CLIENT_URL=http://localhost:5173
